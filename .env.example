# ─────────────────────────────────────────────────────────────────────────────
# RestockIQ — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection URL used by SQLAlchemy and Alembic.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB  (async; for Alembic
# migrations, the sync psycopg2 URL is constructed from this automatically.)
DATABASE_URL=postgresql+asyncpg://restockiq:password@localhost:5432/restockiq

# ── WERET Integration ─────────────────────────────────────────────────────────
# Used by WeretNotifier and WeretPaymentTrigger to push outbound calls.
WERET_BASE_URL=http://localhost:3000

# API key issued by WERET for outbound REST calls (notification + payment trigger).
WERET_API_KEY=your-weret-api-key-here

# Shared HMAC-SHA256 secret used to verify the authenticity of inbound WERET
# webhook payloads.  Generate with: openssl rand -hex 32
WERET_WEBHOOK_SECRET=your-weret-webhook-secret-here

# ── Application ───────────────────────────────────────────────────────────────
# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Environment name used to toggle behaviour 
# Values: development | staging | production
APP_ENV=development

# ── Security ──────────────────────────────────────────────────────────────────
# Secret key for any signed tokens the application issues.
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ── Solver Tuning (optional) ──────────────────────────────────────────────────
# Number of demand scenarios for the SAA solver (higher = more accurate, slower).
# Default: 200.  Minimum: 10.
SAA_N_SCENARIOS=200

# Random seed for the SAA solver — set to a fixed integer for reproducible results
# in tests/dev.  Leave blank (or omit) for non-deterministic production runs.
SAA_SEED=
